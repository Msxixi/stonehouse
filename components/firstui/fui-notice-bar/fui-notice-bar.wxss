.notice-wrap {
  background: #fff3d8;
  color: #8a5932;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  overflow: hidden;
}

.notice-prefix {
  flex-shrink: 0;
  font-weight: 700;
}

.notice-marquee {
  overflow: hidden;
  white-space: nowrap;
  flex: 1;
}

.notice-track {
  display: inline-block;
  padding-left: 100%;
  animation: notice-scroll 12s linear infinite;
}

@keyframes notice-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}
