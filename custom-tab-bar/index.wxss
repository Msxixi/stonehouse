.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 248, 239, 0.98);
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(69, 44, 23, 0.1);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  padding: 12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom));
  z-index: 99;
  box-sizing: border-box;
}

.bottom-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  color: #7c5d45;
  border-radius: 18rpx;
  gap: 8rpx;
}

.bottom-nav-item.active {
  background: #5b3b23;
  color: #fff8ef;
}

.bottom-nav-icon {
  width: 38rpx;
  height: 38rpx;
}

.bottom-nav-text {
  font-size: 20rpx;
  line-height: 1.2;
}
