page {
  min-height: 100%;
  background: #efe6d7;
  color: #34261a;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-shell {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card,
.content-card,
.form-card,
.manage-card,
.list-card,
.grid-card,
.booking-card,
.room-card {
  background: rgba(255, 248, 239, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(74, 47, 22, 0.08);
}

.panel-box {
  padding: 28rpx;
}

.card-box {
  padding: 24rpx;
}

.hero-card {
  padding: 32rpx;
  background: linear-gradient(135deg, #f9efe0, #e5ccb0);
}

.hero-card .section-title {
  margin-bottom: 12rpx;
  line-height: 1.25;
  word-break: break-word;
}

.hero-card .section-subtitle {
  line-height: 1.6;
  word-break: break-word;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #7a5a42;
}

.pill {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #5b3b23;
  color: #fff7ef;
  font-size: 22rpx;
}

.nav-row {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
  overflow-x: auto;
  white-space: nowrap;
}

.nav-btn {
  flex-shrink: 0;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: #fff8ef;
  color: #5f4129;
  font-size: 26rpx;
  border: 2rpx solid rgba(95, 65, 41, 0.12);
  box-sizing: border-box;
  line-height: 1.3;
}

.nav-btn.active {
  background: #5f4129;
  color: #fff8ef;
}

.primary-btn {
  background: #5b3b23;
  color: #fff7ef;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  border: none;
  line-height: 1.3;
  box-sizing: border-box;
}

.secondary-btn {
  background: #e7d2ba;
  color: #5b3b23;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  border: none;
  line-height: 1.3;
  box-sizing: border-box;
}

.mini-btn {
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: #f0e0cf;
  color: #5b3b23;
  font-size: 20rpx;
  border: none;
  line-height: 1.2;
  box-sizing: border-box;
}

.danger-btn {
  background: #8f4a32;
  color: #fffaf5;
}

.img-cover {
  width: 100%;
  border-radius: 22rpx;
  display: block;
}

.price-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #7d2f16;
}

.muted {
  color: #7a5a42;
}

.field-label {
  font-size: 26rpx;
  color: #5f4129;
  margin-bottom: 12rpx;
  display: block;
}

.field-input,
.field-textarea,
.picker-field {
  width: 100%;
  box-sizing: border-box;
  background: #fffdf8;
  border: 2rpx solid #ead7c3;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #34261a;
}

.field-input,
.picker-field {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
}

.field-textarea {
  min-height: 180rpx;
  padding: 20rpx;
  line-height: 1.5;
}

.mt16 {
  margin-top: 16rpx;
}

.mt24 {
  margin-top: 24rpx;
}

.mt32 {
  margin-top: 32rpx;
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.grid-two > view,
.grid-two > block,
.two-col-card > view {
  min-width: 0;
}

.toolbar-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.icon-plus {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #5b3b23;
  color: #fff8ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

.tag-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.tag-item {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f2e4d5;
  color: #6a472d;
  font-size: 24rpx;
}

.tag-item.active {
  background: #5b3b23;
  color: #fff8ef;
}

.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(31, 20, 11, 0.36);
  z-index: 120;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.backdrop-panel {
  align-items: flex-end;
}

.popup-card {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: #fff8ef;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.tab-popup-card {
  margin-bottom: calc(104rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 24rpx 24rpx;
}

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  background: #3f2a1c;
  color: #fff8ef;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 16rpx 32rpx rgba(50, 32, 18, 0.18);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 95;
  box-sizing: border-box;
}

.cart-actions {
  display: flex;
  gap: 10rpx;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.ghost-btn {
  border: 2rpx solid rgba(255, 248, 239, 0.6);
  color: #fff8ef;
  background: transparent;
  padding: 8rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.tabs-row {
  display: flex;
  gap: 18rpx;
  overflow-x: auto;
}

.tab-item {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #f0e2d3;
  color: #6a472d;
  font-size: 24rpx;
}

.tab-item.active {
  background: #5b3b23;
  color: #fff8ef;
}

.two-col-card {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(160rpx, 0.9fr);
  gap: 20rpx;
  align-items: stretch;
}

.right-action-panel {
  background: #f5e7d6;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
  align-items: stretch;
}

.right-action-panel .mini-btn,
.right-action-panel .danger-btn {
  width: 100%;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.collapse-card {
  overflow: hidden;
}

.collapse-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.collapse-body {
  padding: 0 24rpx 24rpx;
  border-top: 2rpx solid #f0e2d3;
}

.circle-wrap {
  width: 36vw;
  height: 36vw;
  max-width: 220rpx;
  max-height: 220rpx;
  min-width: 170rpx;
  min-height: 170rpx;
  border-radius: 50%;
  background: conic-gradient(#5b3b23 var(--progress), #ead8c6 0);
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-inner {
  width: 72%;
  height: 72%;
  border-radius: 50%;
  background: #fff8ef;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5b3b23;
  padding: 8rpx;
  box-sizing: border-box;
  text-align: center;
}

.safe-text {
  word-break: break-all;
}
