.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #f2eee7;
}

.login-bg,
.login-overlay {
  position: absolute;
  inset: 0;
}

.login-bg {
  width: 100%;
  height: 100%;
  filter: saturate(0.72) brightness(1.06);
}

.login-overlay {
  background: rgba(247, 243, 236, 0.8);
  backdrop-filter: blur(2px);
}

.login-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 84rpx 54rpx 72rpx;
  display: flex;
  flex-direction: column;
}

.brand-block {
  margin-top: 36rpx;
  align-items: center;
  display: flex;
  flex-direction: column;
}

.brand-icon {
  font-size: 62rpx;
  color: #4d6f72;
  line-height: 1;
}

.brand-title {
  margin-top: 52rpx;
  font-size: 76rpx;
  line-height: 1.1;
  color: #43696c;
  font-family: "Times New Roman", serif;
  font-style: italic;
}

.brand-meta {
  margin-top: 18rpx;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #9d8478;
}

.login-form {
  margin-top: 126rpx;
}

.login-label {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #8d6d5f;
}

.login-label-gap {
  margin-top: 48rpx;
}

.login-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  font-size: 28rpx;
  color: #6e5a52;
  border-bottom: 1px solid rgba(160, 150, 142, 0.45);
  box-sizing: border-box;
}

.login-placeholder {
  color: #c8c2bd;
}

.login-main-btn {
  margin-top: 76rpx;
  width: 100%;
  height: 112rpx;
  border-radius: 0;
  background: #4d6f72;
  color: #f8f5ef;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-title {
  margin-top: 86rpx;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #b0a6a0;
}

.entry-grid {
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 22rpx;
}

.entry-card {
  background: rgba(245, 241, 236, 0.92);
  padding: 42rpx 22rpx 34rpx;
  min-height: 220rpx;
  box-sizing: border-box;
}

.entry-icon {
  font-size: 42rpx;
  color: #b09d95;
}

.entry-name {
  margin-top: 34rpx;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #7c5f53;
  font-weight: 700;
}

.entry-copy {
  margin-top: 18rpx;
  font-size: 18rpx;
  color: #aba39d;
}

.login-quote {
  margin-top: auto;
  padding: 90rpx 20rpx 20rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.8;
  color: #b29c96;
  font-family: "Times New Roman", serif;
  font-style: italic;
}
