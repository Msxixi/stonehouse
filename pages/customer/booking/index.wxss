.room-card {
  overflow: hidden;
}

.room-cover {
  width: 100%;
  height: 260rpx;
  display: block;
}

.room-content {
  padding: 24rpx;
}

.room-name {
  font-size: 32rpx;
  font-weight: 700;
}

.room-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #7a5a42;
}
