.manage-panel,
.manage-card {
  padding: 28rpx;
  box-sizing: border-box;
}

.manage-image {
  width: 100%;
  height: 220rpx;
  border-radius: 20rpx;
  display: block;
  object-fit: cover;
}

.manage-head,
.action-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.manage-name {
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
}

.action-row {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.sales-panel {
  display: flex;
  justify-content: center;
}

.circle-value {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  word-break: break-all;
}

.sales-panel .muted {
  font-size: 18rpx;
  line-height: 1.3;
}

.manage-card,
.collapse-card {
  min-width: 0;
  overflow: hidden;
}

.field-input,
.picker-field {
  min-width: 0;
}

.manage-product-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
}

.product-edit-card {
  padding: 20rpx;
}

.product-edit-card .manage-image {
  height: 144rpx;
}

.product-edit-card .mt24 {
  margin-top: 14rpx;
}

.edit-field-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.product-edit-metrics {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.product-edit-card .field-label {
  margin-bottom: 0;
  font-size: 20rpx;
  line-height: 1.2;
}

.edit-input,
.edit-picker-field {
  height: 60rpx;
  min-height: 60rpx;
  padding: 0 14rpx;
  background: #fffaf4;
  border-color: #d8bea3;
  color: #2f2115;
  font-size: 22rpx;
  line-height: 60rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(91, 59, 35, 0.04);
}

.edit-picker-field {
  display: flex;
  align-items: center;
  line-height: 1.25;
}

.product-edit-card .mini-btn {
  padding: 6rpx 12rpx;
  font-size: 18rpx;
  border-radius: 12rpx;
}

.manage-search-input {
  height: 68rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 20rpx;
  background: #fffaf4;
  border-color: #dec7ae;
}

@media (max-width: 360px) {
  .manage-product-grid {
    grid-template-columns: 1fr;
  }
}

.page-shell-lock {
  height: 100vh;
  overflow: hidden;
}

.staff-popup-mask {
  background: rgba(239, 230, 215, 0.9);
}

.staff-popup-card {
  max-height: calc(100vh - env(safe-area-inset-top));
  box-shadow: 0 -16rpx 32rpx rgba(52, 38, 26, 0.12);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
