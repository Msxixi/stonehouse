.manage-panel,
.manage-card {
  padding: 28rpx;
  box-sizing: border-box;
}

.manage-image {
  width: 100%;
  height: 220rpx;
  border-radius: 20rpx;
  display: block;
  object-fit: cover;
}

.manage-head,
.action-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.manage-name {
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
}

.action-row {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.manage-card {
  min-width: 0;
  overflow: hidden;
}

.field-input,
.field-textarea {
  min-width: 0;
}

.manage-search-input {
  height: 68rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 20rpx;
  background: #fffaf4;
  border-color: #dec7ae;
}

.bean-product-grid {
  align-items: start;
}

.bean-summary-card {
  padding: 18rpx;
}

.bean-summary-image {
  height: 180rpx;
}

.bean-summary-body {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bean-summary-name {
  font-size: 26rpx;
  line-height: 1.35;
}

.bean-summary-meta {
  font-size: 20rpx;
}

.page-shell-lock {
  height: 100vh;
  overflow: hidden;
}

.staff-popup-mask {
  background: rgba(239, 230, 215, 0.9);
}

.staff-popup-card {
  max-height: calc(100vh - env(safe-area-inset-top));
  box-shadow: 0 -16rpx 32rpx rgba(52, 38, 26, 0.12);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
